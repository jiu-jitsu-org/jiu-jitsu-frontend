# External API base URL used by the BFF layer.
# Copy this file to `.env.development` or `.env.production` and adjust values by environment.
# 개발: https://dev-api.bjj-oss.kr (swagger: /api/swagger-ui/index.html)
# 운영: https://api.bjj-oss.kr
API_BASE_URL=

# Optional. Preferred over API_BASE_URL when set (server-to-server / internal hostname).
# config/env.ts reads INTERNAL_API_BASE_URL ?? API_BASE_URL.
INTERNAL_API_BASE_URL=

# Optional timeout in milliseconds for upstream API requests made by the BFF.
API_TIMEOUT_MS=

# (dev only) 업스트림 API 요청/응답을 서버 터미널에 로깅한다. 디버깅용.
# `true`일 때만 켜지며, NODE_ENV=production 빌드에서는 무조건 무시된다.
# 민감 헤더(Authorization/Cookie 등)는 마스킹되어 찍힌다. 운영 env에는 넣지 않는다.
API_DEBUG_LOG=

# (dev only) iOS 웹뷰를 LAN IP로 띄워 테스트할 때 dev 서버 cross-origin 차단을 풀어줄 origin 목록.
# 본인 개발 머신의 LAN IP를 넣는다. 여러 개면 콤마로 구분. 예: 172.30.1.18,192.168.0.10
DEV_ALLOWED_ORIGINS=

# (public, optional) ImageKit 브라우저 업로드 설정. 비밀이 아니므로 클라이언트 노출 정상.
# 미설정 시 config/env.ts의 주짓수랩 계정 기본값을 사용한다. 서버 서명(/image/auth)과 같은 계정이어야 한다.
NEXT_PUBLIC_IMAGEKIT_UPLOAD_URL=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
